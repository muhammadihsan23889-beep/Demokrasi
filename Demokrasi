const MISI_KODE=[{q:'Pesan viral tanpa sumber jelas muncul di grup. Langkah pertama?',o:['Teruskan ke grup lain','Periksa sumber asli','Ubah judul agar menarik'],k:1,token:'CEK'},{q:'Dua unggahan memiliki foto sama tetapi tanggal berbeda. Apa yang perlu diuji?',o:['Konteks dan tanggal foto','Jumlah emoji','Warna profil pengirim'],k:0,token:'FAKTA'},{q:'Akun anonim menuduh seseorang tanpa bukti. Respons yang tepat?',o:['Sebarkan identitas orang itu','Ikut menuduh','Hentikan sebar dan verifikasi'],k:2,token:'SANTUN'}];
function finalGame(){T.phase='cipher';T.cipher=0;T.tokens=[];T.path=0;T.ethic=0;T.metrics=[50,50,50];T.boss=0;T.correct=0;T.bossShield=3;renderCipher()}
function renderCipher(){if(T.cipher>=MISI_KODE.length)return renderChase();let x=MISI_KODE[T.cipher];shell('🔐 Babak 5 · Pecahkan Kode',`${owl('Tiga terminal keamanan mengunci lokasi akun bayangan. Pecahkan kasus untuk memperoleh token sandi.')}<div class="glass"><div class="row spread"><b>TERMINAL ${T.cipher+1}/3</b><b>🔑 ${T.tokens.join(' · ')||'???'}</b></div><div class="cipher-display">${'▣ '.repeat(3-T.cipher)} ${T.tokens.join(' · ')}</div><h3>${esc(x.q)}</h3><div class="options">${x.o.map((v,i)=>`<button onclick="cipherAnswer(${i})">${esc(v)}</button>`).join('')}</div></div>`)}
function cipherAnswer(i){let x=MISI_KODE[T.cipher];if(i===x.k){T.tokens.push(x.token);T.cipher++;T.correct++;add(15);beep();toast('🔓 Token berhasil didekripsi!');renderCipher()}else{beep(false);toast('Kode ditolak! Analisis lagi petunjuknya.')}}
const JALUR=[{q:'Jejak awal: unggahan sensasional muncul tanpa sumber. Titik pemeriksaan berikutnya?',o:['Sumber unggahan','Jumlah suka','Foto profil'],k:0},{q:'Sumber sudah diperiksa. Apa yang menguatkan penelusuran?',o:['Komentar paling keras','Pembanding dari sumber tepercaya','Pesan berantai baru'],k:1},{q:'Sumber pembanding menunjukkan konteks berbeda. Apa langkah aman?',o:['Menuduh pemilik akun','Membagikan ulang rumor','Mencatat temuan dan menghentikan penyebaran'],k:2}];
function renderChase(){if(T.path>=JALUR.length)return ethicQ();let x=JALUR[T.path];shell('🕸️ Kejar Jejak Digital',`${owl('Ikuti jalur verifikasi yang masuk akal. Salah belok membuatmu kembali memeriksa simpang yang sama.')}<div class="glass"><div class="network-track">${['📱','🔎','📰','🛡️'].map((v,i)=>`<span class="${i<=T.path?'lit':''}">${v}</span>`).join('<span>━</span>')}</div><h3>Simpang ${T.path+1}/3</h3><p>${esc(x.q)}</p><div class="options">${x.o.map((v,i)=>`<button onclick="chaseAnswer(${i})">${esc(v)}</button>`).join('')}</div></div>`)}
function chaseAnswer(i){let x=JALUR[T.path];if(i===x.k){T.path++;T.correct++;add(15);beep();renderChase()}else{beep(false);toast('Jalan buntu! Gunakan bukti, bukan popularitas atau dugaan.')}}
function ethicQ(){if(T.ethic>=3)return bossQ();let x=BANK_SOAL.dilema[T.ethic];shell('⚖️ Pilihan Penyelamat Kota',`${owl('Tentukan tindakan yang menjaga ruang dialog dan meminimalkan dampak buruk. Setiap keputusan mengubah kondisi kota.')}<div class="glass"><h3>Dilema ${T.ethic+1}/3</h3><div class="meter">${['Ketenangan','Kepercayaan','Kebebasan'].map((n,i)=>`<div class="card"><small>${n}</small><div class="progress"><div style="width:${T.metrics[i]}%"></div></div><b>${T.metrics[i]}</b></div>`).join('')}</div><p>${esc(x.q)}</p><div class="options">${x.o.map((v,i)=>`<button onclick="chooseEthic(${i})">${esc(v[0])}</button>`).join('')}</div></div>`)}
function chooseEthic(i){let x=BANK_SOAL.dilema[T.ethic].o[i];T.metrics=T.metrics.map((v,j)=>Math.max(0,Math.min(100,v+x[1][j])));if(i===0){T.correct++;add(15)}else add(4);beep(i===0);shell('🌆 Dampak Keputusan',`${owl(x[2],i===0)}<div class="glass"><div class="meter">${['Ketenangan','Kepercayaan','Kebebasan'].map((n,j)=>`<div class="card"><small>${n}</small><div class="progress"><div style="width:${T.metrics[j]}%"></div></div><b>${T.metrics[j]}</b></div>`).join('')}</div><button onclick="T.ethic++;ethicQ()">${T.ethic===2?'⚔️ Hadapi Dalang':'Lanjutkan Misi'}</button></div>`)}
function bossQ(){if(T.boss>=5)return reveal();let x=BANK_SOAL.boss[T.boss];shell('⚔️ Duel Final · Dalang Hoaks',`${owl('Tangkis lima serangan informasi menyesatkan. Jika perisai habis, duel diulang tanpa menghapus misi sebelumnya.')}<div class="glass"><div class="row spread"><b>👤 DALANG ${5-T.boss}/5</b><b>🛡️ ${'💙'.repeat(T.bossShield)}</b></div><div class="progress"><div style="width:${T.boss*20}%"></div></div><div class="boss-face">👤<span class="boss-glitch">⚡</span></div><h3 class="center">SERANGAN ${T.boss+1}</h3><p class="stamp center">${esc(x.q)}</p><div class="options">${x.o.map((v,i)=>`<button onclick="bossAnswer(${i})">🛡️ ${esc(v)}</button>`).join('')}</div><button class="secondary" onclick="hint(['Pilih tanggapan yang dapat diverifikasi.','Hak dan tanggung jawab perlu berjalan bersama.'])">🦉 Petunjuk</button></div>`)}
function bossAnswer(i){let x=BANK_SOAL.boss[T.boss];if(i===x.k){T.boss++;T.correct++;add(20);beep();toast('💥 SERANGAN DIPATAHKAN!');bossQ()}else{T.bossShield--;beep(false);if(T.bossShield<=0){T.boss=0;T.bossShield=3;shell('🛡️ Perisai Perlu Diisi Ulang',`${owl('Dalang memanfaatkan jawaban tergesa-gesa. Ulangi duel dan periksa setiap klaim dengan teliti.')}<div class="glass"><button onclick="bossQ()">🔄 Ulangi Duel</button></div>`)}else{toast('⚠️ Perisai berkurang. Coba bantahan lain.');bossQ()}}}
function reveal(){confetti();shell('🎭 Dalang Terungkap!',`${owl('Jejak bukti mengarah pada Akun Bayangan, akun fiktif penyunting judul provokatif. Identitas orang di baliknya belum terbukti; jangan menuduh seseorang tanpa verifikasi.',true)}<div class="glass center"><div class="boss-face">🕵️‍♀️🏆</div><h2>MISI SANTUNLANDIA BERHASIL!</h2><p>Token rahasia: <b>${T.tokens.join(' · ')}</b></p><p>Kamu menelusuri sumber, membandingkan bukti, dan memilih respons yang menghormati hak orang lain.</p><button onclick="complete(4,T.correct,14,'Verifikasi fakta, etika dialog, dan tanggung jawab digital melindungi demokrasi.')">🏅 Klaim Sertifikat</button></div>`)}
function certificate(){if(!S.finishedAt){S.finishedAt=Date.now();save()}let d=new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});shell('🎓 Sertifikat Detektif',`<div class="certificate center" id="cert"><div style="font-size:45px">🏅🦉</div><h2>SERTIFIKAT DETEKTIF DEMOKRASI</h2><p>Diberikan kepada</p><h2>${esc(S.name)}</h2><p>Kelas ${esc(S.classroom)}</p><p>Atas keberhasilan menyelesaikan Misteri Santunlandia dan menerapkan perilaku demokratis pada era keterbukaan informasi.</p><h3>Skor ${S.score} · XP ${S.xp}</h3><p>${S.stars.map(x=>'⭐'.repeat(x)).join(' · ')}</p><p>${d}</p><p class="small">Detektif Demokrasi · Santunlandia</p></div><div class="glass center"><button onclick="window.print()">🖨️ Cetak / Simpan PDF</button> <button class="secondary" onclick="leaderboard()">Papan Peringkat</button> <button class="ghost" onclick="map()">Peta</button></div>`);recordRank()}function elapsed(ms){let t=Math.max(0,Math.floor(ms/1000));return `${Math.floor(t/3600)}j ${Math.floor(t%3600/60)}m ${t%60}d`}
function rankSort(a){return a.sort((x,y)=>Number(y.score)-Number(x.score)||Number(x.duration)-Number(y.duration))}
function recordRank(){try{let a=JSON.parse(localStorage.getItem('santun_rank')||'[]');let r={name:S.name,classroom:S.classroom,score:S.score,duration:Math.max(0,S.finishedAt-S.startedAt),date:new Date().toLocaleDateString('id-ID')};let idx=a.findIndex(v=>v.name===r.name&&v.classroom===r.classroom);if(idx<0)a.push(r);else if(r.score>a[idx].score||(r.score===a[idx].score&&r.duration<a[idx].duration))a[idx]=r;localStorage.setItem('santun_rank',JSON.stringify(rankSort(a).slice(0,100)));if(ONLINE_RANK_API)fetch(ONLINE_RANK_API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(r)}).catch(()=>{})}catch(e){}}
async function leaderboard(){let a=[];try{a=JSON.parse(localStorage.getItem('santun_rank')||'[]')}catch(e){}let shared=false;if(ONLINE_RANK_API){try{let res=await fetch(ONLINE_RANK_API);if(!res.ok)throw Error('API');let data=await res.json();if(!Array.isArray(data))throw Error('format');a=data;shared=true}catch(e){toast('Server peringkat tidak tersedia; menampilkan data lokal.')}}rankSort(a);shell('🏆 Papan Peringkat '+(shared?'Bersama':'Lokal'),`<div class="glass"><p class="muted">${shared?'Hasil dari server bersama':'Hanya hasil yang tersimpan di perangkat ini'}. Urutan: skor tertinggi, lalu waktu tercepat.</p><div class="rank-head"><b>#</b><b>Detektif / Kelas</b><b>Nilai</b><b>Waktu</b></div>${a.length?a.map((x,i)=>`<div class="rank-row"><b>${i+1}</b><span>${esc(x.name)}<small>${esc(x.classroom||'-')}</small></span><b>${Number(x.score)||0}</b><span>${x.duration!=null?elapsed(Number(x.duration)):'—'}</span></div>`).join(''):'Belum ada detektif yang menamatkan misi.'}<p><button onclick="certificate()">Kembali ke Sertifikat</button></p></div>`)}
start();
</script><style media="print">body{background:white;color:#111}main{max-width:100%}.nav,button,.glass:not(.certificate),#toast{display:none!important}.certificate{color:#1b1640;background:#fff;border-color:#b58b35;box-shadow:none}h2,h3{color:#7a561b}
/* Peta wilayah bergaya ilustrasi, sepenuhnya offline */
.world-map{position:relative;width:100%;max-width:480px;height:570px;margin:20px auto;overflow:hidden;border-radius:28px;background:radial-gradient(ellipse at 40% 40%,#284875,#0b1738 75%);border:2px solid #d5b86d;box-shadow:inset 0 0 50px #050b2b,0 12px 35px #0005}
.map-land{position:absolute;inset:0;width:100%;height:100%;filter:drop-shadow(0 6px 9px #0006)}
.map-stop{position:absolute;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;gap:2px;width:142px;min-height:75px;padding:7px 8px;background:#111e45e8;color:#fff;border:2px solid #f2cc78;border-radius:16px;box-shadow:0 4px 18px #0008;cursor:pointer;touch-action:manipulation;font-size:12px;line-height:1.15}
.map-stop:disabled{opacity:.65;filter:grayscale(.65);cursor:not-allowed}.map-stop.cleared{border-color:#69efcf}.map-stop .map-icon{font-size:22px}.map-label{font-weight:800}.map-stop small{font-size:10px;color:#ffe6a4}.stop-0{left:20%;top:83%}.stop-1{left:32%;top:63%}.stop-2{left:65%;top:49%}.stop-3{left:38%;top:33%}.stop-4{left:73%;top:17%}
.rank-head,.rank-row{display:grid;grid-template-columns:25px minmax(0,1fr) 53px 79px;gap:7px;align-items:center;padding:11px 5px;border-bottom:1px solid #ffffff30;font-size:12px}.rank-head{color:#ffda82}.rank-row small{display:block;color:#a8b9d6;margin-top:3px}.rank-row span{overflow-wrap:anywhere}
@media(max-width:380px){.map-stop{width:116px;font-size:11px}.world-map{height:550px}.rank-head,.rank-row{font-size:11px;grid-template-columns:22px minmax(0,1fr) 43px 67px}}
</style></body></html>

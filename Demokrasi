><path d="M24 34l7-20h47l8 20z" fill="#28334d"/><rect x="17" y="31" width="76" height="8" rx="3" fill="#f4c36c"/><circle cx="87" cy="92" r="15" fill="none" stroke="#ffd477" stroke-width="5"/><path d="M98 104l11 17" stroke="#ffd477" stroke-width="6"/><path d="M33 117l-6 9m45-9 6 9" stroke="#ffb74d" stroke-width="5"/></svg><div class="dialog"><b class="gold">Profesor Hootie</b><div>${esc(msg)}</div></div></div>`}function shell(title,body){app.innerHTML=`<div class="nav"><button class="secondary" onclick="map()">🗺️ Peta</button><span class="stat">⭐ ${S.score} · XP ${S.xp} · ❤️ ${S.hearts}</span><button class="secondary" onclick="sound()">${S.sound?'🔊':'🔇'}</button></div><h2>${title}</h2>${body}`;window.scrollTo(0,0)}function sound(){S.sound=!S.sound;save();let b=$('.nav button:last-child');if(b)b.textContent=S.sound?'🔊':'🔇'}function start(){app.innerHTML=`<div class="glass center"><div style="font-size:64px">🕵️‍♀️ 🦉 🔎</div><h1>Detektif Demokrasi</h1><h3>Misteri Santunlandia</h3><p>Hoaks berantai mengacaukan kota. Temukan sumbernya melalui lima misi analisis, evaluasi, dan keputusan etis!</p>${owl('Selamat datang, Detektif! Nama samaranmu boleh keren, tetapi bukti harus benar.')}<p><input id="name" maxlength="35" placeholder="Nama detektif" value="${esc(S.name)}"></p><p><input id="classroom" maxlength="25" placeholder="Kelas (contoh: XI 2)" value="${esc(S.classroom||'')}"></p><div class="row" style="justify-content:center"><button onclick="begin()">Mulai Misi ✨</button><button class="secondary" onclick="help()">Cara Bermain</button></div>${S.name?'<p><button class="ghost" onclick="map()">Lanjutkan permainan tersimpan</button></p>':''}</div>`}function help(){shell('📜 Cara Bermain',`<div class="glass">Selesaikan lima babak secara berurutan. Baca arsip, isi kalimat dengan drag atau tap, susun pernyataan, bantah saksi memakai bukti, lalu pecahkan kasus dan pilih tindakan etis. Petunjuk maksimal dua per soal dan mengurangi skor. Kemajuan tersimpan di perangkat ini. <p>🟡 Skor